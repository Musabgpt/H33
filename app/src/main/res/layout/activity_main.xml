<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AraGPT2 — يتعلم منك على الهاتف"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="start" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جاري التهيئة…"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:gravity="start"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) السؤال"
            android:textStyle="bold"
            android:gravity="start" />

        <EditText
            android:id="@+id/questionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:maxLines="5"
            android:hint="اكتب سؤالك هنا"
            android:gravity="start|top"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:id="@+id/askButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اسأل النموذج"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2) جواب النموذج"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:gravity="start" />

        <EditText
            android:id="@+id/answerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="110dp"
            android:maxLines="9"
            android:hint="سيظهر جواب AraGPT2 هنا"
            android:gravity="start|top"
            android:textIsSelectable="true"
            android:focusable="false"
            android:cursorVisible="false" />

        <Button
            android:id="@+id/correctButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ الإجابة صحيحة — عززها"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3) التصحيح / الجواب الأفضل"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:gravity="start" />

        <EditText
            android:id="@+id/correctionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="110dp"
            android:maxLines="9"
            android:hint="إذا كان الجواب خطأ، اكتب الجواب الصحيح هنا"
            android:gravity="start|top"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:id="@+id/teachButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="علّم النموذج من التصحيح"
            android:enabled="false" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مسح الحقول"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ملاحظة: زر مسح يمسح الحقول فقط. أوزان التعلم تبقى محفوظة محليًا على الهاتف."
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:gravity="start" />

    </LinearLayout>
</ScrollView>
